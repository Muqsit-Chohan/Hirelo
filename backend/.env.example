PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_backend_service_role_key
SECRET_KEY=replace_with_a_long_random_jwt_secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Only needed to run `npm run db:setup` (applies supabase/schema.sql via a direct connection).
DATABASE_URL=postgresql://postgres.your-project:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional: enables WhatsApp acceptance notifications via Twilio.
# Leave as-is to skip WhatsApp sending (email notifications still work without these).
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
